PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Database: SQLite by default. For Neon/Postgres:
# DB_TYPE=postgres
# DB_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_PATH=data/theround.sqlite

# Audio: Cloudflare R2 (leave S3_ENDPOINT unset to use local disk in dev)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=theround-audio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=uploads
