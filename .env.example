PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Public origin of this API (no /api). Unsubscribe links in newsletters point here.
API_PUBLIC_URL=http://localhost:3000

# Admin dashboard: creates the first owner on boot while there are no admins yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database: SQLite by default. For Neon/Postgres:
# DB_TYPE=postgres
# DB_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_PATH=data/theround.sqlite

# Audio: Neon object storage, S3-compatible (leave S3_ENDPOINT unset to use local disk in dev)
# S3_ENDPOINT=https://<BUCKET_ENDPOINT>.storage.<region>.aws.neon.tech
# S3_BUCKET=theround
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=uploads

# Email: Resend (https://resend.com/api-keys). Without RESEND_API_KEY, sends are logged and skipped.
# RESEND_FROM must be on a domain verified in Resend; resend.dev only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM="The Round <hello@gettheround.com>"
RESEND_REPLY_TO="support@gettheround.com"
# Where email CTAs (welcome, invite) send people: the web app.
APP_URL=http://localhost:5173
# Public HTTPS origin serving the logo (the landing page); defaults to https://gettheround.com
# EMAIL_ASSET_ORIGIN=https://gettheround.com
# RESEND_UNSUBSCRIBE_URL=https://gettheround.com/unsubscribe
# COMPANY_ADDRESS="The Round Inc., 123 Main St, New York, NY 10001"
